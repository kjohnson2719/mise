{
  "name": "@merran/server",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.ts",
    "start": "node src/index.ts",
    "test": "vitest run --project sqlite",
    "typecheck": "tsc",
    "db:migration": "node src/database/make-migration.ts",
    "db:test-postgres": "docker run -d --rm --name merran-test-postgres -e POSTGRES_PASSWORD=merran -p 5433:5432 --tmpfs /var/lib/postgresql postgres:18",
    "test:all": "vitest run",
    "openapi": "node src/http/openapi/export.ts",
    "merran": "node src/cli/index.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.75",
    "@ai-sdk/google": "^4.0.91",
    "@ai-sdk/openai": "^4.0.88",
    "@ai-sdk/openai-compatible": "^3.0.65",
    "@hono/node-server": "^2.1.5",
    "@hono/zod-openapi": "^1.6.3",
    "@merran/shared": "workspace:*",
    "@mikro-orm/core": "^7.2.5",
    "@mikro-orm/migrations": "^7.2.5",
    "@mikro-orm/postgresql": "^7.2.5",
    "@mikro-orm/sql": "^7.2.5",
    "@mikro-orm/sqlite": "^7.2.5",
    "@scalar/hono-api-reference": "^0.12.12",
    "@sentry/node": "11.7.0",
    "ai": "^7.0.132",
    "better-auth": "^1.7.8",
    "cheerio": "1.2.0",
    "croner": "10.0.1",
    "hono": "^4.13.13",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "sharp": "0.35.5",
    "undici": "7.30.0",
    "uuid": "^14.0.3",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "pg": "^8.23.1",
    "vitest": "^5.0.4"
  }
}
